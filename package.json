{
  "name": "rdscostoptimization",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone RDS SQL Server workload optimization engine and harness.",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "test": "npm run build && node --test tests/**/*.test.js && powershell -ExecutionPolicy Bypass -File tests/run-typescript-tests.ps1",
    "harness": "node --test tests/harness/**/*.test.js",
    "samples:generate": "node scripts/generate-tool-regression-samples.mjs",
    "build:app": "tsc -p tsconfig.app.json",
    "catalog:refresh": "npm run build:app && node dist/catalog/refresh.js",
    "server": "npm run build:app && node dist/server/index.js",
    "dev": "npm run server"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.4.0",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "multer": "^2.3.0"
  }
}
